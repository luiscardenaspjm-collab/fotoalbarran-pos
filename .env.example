# Copia este archivo a ".env" y llénalo con tus credenciales reales de Turso.
# NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).

# URL de la base de datos — la obtienes con: turso db show foto-albarran --url
TURSO_DATABASE_URL=libsql://foto-albarran-tuusuario.turso.io

# Token de autenticación — lo obtienes con: turso db tokens create foto-albarran
TURSO_AUTH_TOKEN=

# Puerto local (Railway asigna el suyo automáticamente vía process.env.PORT)
PORT=3000
